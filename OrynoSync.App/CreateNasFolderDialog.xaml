<Window x:Class="OrynoSync.App.CreateNasFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create NAS folder" Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
  <StackPanel Margin="24">
    <TextBlock Text="Create NAS folder" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Text="Folder name:" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,4"/>
    <TextBox x:Name="FolderNameBox" MaxLength="120" KeyDown="FolderNameBox_KeyDown"/>
    <TextBlock x:Name="ErrorText" Foreground="#E0655A" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
    <WrapPanel HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Cancel" Click="Cancel_Click"/>
      <Button x:Name="CreateButton" Content="Create" IsDefault="True" Margin="8,0,0,0" Click="Create_Click"/>
    </WrapPanel>
  </StackPanel>
</Window>