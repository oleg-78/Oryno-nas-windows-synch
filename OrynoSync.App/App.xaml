<Application x:Class="OrynoSync.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OrynoSync.App"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#111417"/><SolidColorBrush x:Key="PanelBrush" Color="#1A1F24"/><SolidColorBrush x:Key="TextBrush" Color="#F3F5F7"/><SolidColorBrush x:Key="MutedBrush" Color="#9AA5AF"/><SolidColorBrush x:Key="AccentBrush" Color="#79D6B2"/>
        <local:InverseBooleanConverter x:Key="InverseBoolean"/>
        <Style x:Key="NavButton" TargetType="Button"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="8,10"/><Setter Property="Margin" Value="0,2"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderThickness" Value="0"/></Style>
    </Application.Resources>
</Application>
