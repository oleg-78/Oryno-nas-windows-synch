<Window x:Class="OrynoSync.App.AddFolderWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Add synced folder" Width="520" MinWidth="360" Height="390" WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="24"><TextBlock Text="Add folder" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Choose a folder on this PC" Foreground="{StaticResource MutedBrush}" Margin="0,22,0,4"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse" Click="Browse_Click" Margin="8,5,0,12"/><TextBox x:Name="PathBox"/></DockPanel><TextBlock Text="Choose where to sync on Oryno NAS" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4"/><ComboBox x:Name="RootBox" DisplayMemberPath="Name"/><TextBlock x:Name="OfflineText" Text="Oryno NAS is currently offline. You can add this local folder now and select its NAS destination later." Foreground="#E5B96B" TextWrapping="Wrap" Margin="0,5,0,0"/><WrapPanel HorizontalAlignment="Right" Margin="0,22,0,0"><Button Content="Cancel" Click="Cancel_Click"/><Button x:Name="AddButton" Content="Add folder" Click="Add_Click" Margin="0"/></WrapPanel></StackPanel></ScrollViewer>
</Window>
