<Window x:Class="OrynoSync.App.AddFolderWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Add synced folder" Width="520" Height="390" WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
  <StackPanel Margin="24"><TextBlock Text="Add synced folder" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="1. Choose local folder" Foreground="{StaticResource MutedBrush}" Margin="0,22,0,4"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse" Click="Browse_Click" Margin="8,5,0,12"/><TextBox x:Name="PathBox"/></DockPanel><TextBlock Text="2. Choose Oryno NAS folder" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4"/><ComboBox x:Name="RootBox" DisplayMemberPath="Name"/><TextBlock x:Name="OfflineText" Text="Server offline: root can be selected later." Foreground="#E5B96B" TextWrapping="Wrap" Margin="0,5,0,0"/><WrapPanel HorizontalAlignment="Right" Margin="0,22,0,0"><Button Content="Cancel" Click="Cancel_Click"/><Button Content="Add folder" Click="Add_Click" Margin="0"/></WrapPanel></StackPanel>
</Window>
