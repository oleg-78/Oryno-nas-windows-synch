<UserControl x:Class="OrynoSync.App.Views.FoldersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <DockPanel Margin="0,0,0,14"><TextBlock Text="Synced folders" FontSize="17" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="+ Add folder" Click="AddFolder_Click" Margin="8,0,0,0"/></DockPanel>
    <ItemsControl ItemsSource="{Binding Mappings}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="{StaticResource PanelBrush}" BorderBrush="#303940" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,12"><StackPanel>
        <TextBlock Text="{Binding LocalPath}" FontSize="16" TextWrapping="Wrap"/><TextBlock Text="{Binding RootName, StringFormat=Oryno NAS → {0}}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding Status}" Margin="0,14,0,0"/><TextBlock Text="{Binding PendingText}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/><WrapPanel Margin="0,14,0,0"><Button Content="Open" Click="Open_Click"/><Button Content="Pause / Resume" Click="Pause_Click"/><Button Content="Remove" Click="Remove_Click" Margin="0"/></WrapPanel>
      </StackPanel></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></ScrollViewer>
</UserControl>
