<UserControl x:Class="OrynoSync.App.Views.FoldersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <DockPanel Margin="0,0,0,14"><TextBlock Text="Synced folders" FontSize="17" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="+ Add folder" Click="AddFolder_Click" Margin="8,0,0,0"/></DockPanel>
      <ItemsControl ItemsSource="{Binding Mappings}"><ItemsControl.ItemTemplate><DataTemplate>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="#303940" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,12"><StackPanel>
          <TextBlock Text="{Binding LocalPath}" FontSize="16" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding RootName}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Status}" Margin="0,14,0,0"/>
          <ProgressBar Height="5" Margin="0,8,0,2" IsIndeterminate="True"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsScanning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar>
          <TextBlock Text="{Binding IndexedText}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/><TextBlock Text="{Binding PendingText}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding ErrorsText}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/><TextBlock Text="{Binding LastSyncText}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
          <WrapPanel Margin="0,14,0,0"><Button Content="Open" Click="Open_Click"/><Button Content="Pause / Resume" Click="Pause_Click"/><Button Content="Remove" Click="Remove_Click" Margin="0"/></WrapPanel>
        </StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
