<UserControl x:Class="OrynoSync.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <Border Background="{StaticResource PanelBrush}" BorderBrush="#303940" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16"><StackPanel><TextBlock Text="CONNECTION" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Server" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0"/><TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Device authorization token" Foreground="{StaticResource MutedBrush}"/><PasswordBox x:Name="TokenBox"/><WrapPanel><Button Content="Connect" Click="Connect_Click"/><Button Content="Test connection" Click="TestConnection_Click" Margin="0"/></WrapPanel><TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/></StackPanel></Border>
    <Border Background="{StaticResource PanelBrush}" BorderBrush="#303940" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16"><StackPanel><TextBlock Text="STARTUP" FontSize="10" Foreground="{StaticResource MutedBrush}"/><CheckBox Content="Start Oryno Sync when I sign in to Windows" IsChecked="{Binding StartWithWindows}" Margin="0,12,0,0"/></StackPanel></Border>
    <Border Background="{StaticResource PanelBrush}" BorderBrush="#303940" BorderThickness="1" CornerRadius="8" Padding="18"><StackPanel><TextBlock Text="DIAGNOSTICS" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Device" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0"/><TextBlock Text="{Binding Device}"/><TextBlock Text="Database" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/><TextBlock Text="{Binding DatabasePath}" TextWrapping="Wrap"/><TextBlock Text="Watcher" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/><TextBlock Text="{Binding WatcherStatus}"/><TextBlock Text="Queue" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/><TextBlock Text="{Binding QueueLength}"/></StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
