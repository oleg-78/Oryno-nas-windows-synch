<UserControl x:Class="OrynoSync.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <Border Background="{StaticResource PanelBrush}" BorderBrush="#303940" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="CONNECTION" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
          <TextBlock Text="Oryno NAS" FontSize="17" Margin="0,12,0,0"/>
          <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"/>
          <StackPanel>
            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasCredential}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <TextBlock Text="Enter the authorization token generated by Oryno NAS" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            <PasswordBox x:Name="TokenBox"/>
            <Button Content="Connect" Click="Connect_Click" IsEnabled="{Binding IsConnecting, Converter={StaticResource InverseBoolean}}"/>
          </StackPanel>
          <StackPanel>
            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasCredential}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <TextBlock Text="✓ Device authorized" FontSize="16" Foreground="{StaticResource AccentBrush}" Margin="0,10,0,0"/>
            <TextBlock Text="{Binding Device}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            <WrapPanel Margin="0,12,0,0"><Button Content="Disconnect" Click="Disconnect_Click"/><Button Content="Re-authorize" Click="Reauthorize_Click"/></WrapPanel>
          </StackPanel>
          <WrapPanel Margin="0,8,0,0"><Button Content="Test connection" Click="TestConnection_Click" IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBoolean}}"/></WrapPanel>
          <TextBlock Text="●" Foreground="#79D6B2" FontSize="18" Margin="0,10,0,0"/><TextBlock Text="{Binding ConnectionStatus}" MinHeight="22" Foreground="{StaticResource TextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding TestResult}" MinHeight="22" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Background="{StaticResource PanelBrush}" BorderBrush="#303940" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16"><StackPanel><TextBlock Text="STARTUP" FontSize="10" Foreground="{StaticResource MutedBrush}"/><CheckBox Content="Start Oryno Sync when I sign in to Windows" IsChecked="{Binding StartWithWindows}" Margin="0,12,0,0"/></StackPanel></Border>
      <Border Background="{StaticResource PanelBrush}" BorderBrush="#303940" BorderThickness="1" CornerRadius="8" Padding="18"><StackPanel><TextBlock Text="DIAGNOSTICS" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Device" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0"/><TextBlock Text="{Binding Device}"/><TextBlock Text="Database" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/><TextBlock Text="{Binding DatabasePath}" TextWrapping="Wrap"/><TextBlock Text="Watcher" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/><TextBlock Text="{Binding WatcherStatus}"/><TextBlock Text="Pending changes" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/><TextBlock Text="{Binding QueueLength}"/></StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
