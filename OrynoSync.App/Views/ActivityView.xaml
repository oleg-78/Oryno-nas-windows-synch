<UserControl x:Class="OrynoSync.App.Views.ActivityView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <Border Background="{StaticResource PanelBrush}" BorderBrush="#303940" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
        <StackPanel><TextBlock Text="SYNC STATUS" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Status}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="Local changes continue to queue" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/><WrapPanel Margin="0,16,0,0"><Button Content="Pause / Resume" Click="Pause_Click"/><Button Content="Open folder" Click="OpenFolder_Click" Margin="0"/></WrapPanel></StackPanel>
      </Border>
      <TextBlock Text="Recent activity" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,10"/>
      <ListView ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" MinHeight="120"/>
      <TextBlock Text="{Binding QueueText}" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,20"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
