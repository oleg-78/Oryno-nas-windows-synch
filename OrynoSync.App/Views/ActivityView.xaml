<UserControl x:Class="OrynoSync.App.Views.ActivityView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <Border Background="{StaticResource PanelBrush}" BorderBrush="#303940" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16" MinHeight="170"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="●" Foreground="#79D6B2" FontSize="20" Margin="0,0,8,0"/><TextBlock Text="{Binding Status}" FontSize="21" FontWeight="SemiBold"/></StackPanel><TextBlock Grid.Row="1" Text="{Binding ConnectionMessage}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" MinHeight="26"/><WrapPanel Grid.Row="2" Margin="0,18,0,0"><Button Content="Start" Click="StartSync_Click"/><Button Content="Stop" Click="StopSync_Click" Margin="4,0,0,0"/><Button Content="Open folder" Click="OpenFolder_Click" Margin="4,0,0,0"/></WrapPanel></Grid></Border>
    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="{StaticResource PanelBrush}" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="INDEXED" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding IndexedText}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="local files" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border><Border Grid.Column="1" Background="{StaticResource PanelBrush}" Padding="16" Margin="4,0,4,0"><StackPanel><TextBlock Text="WAITING" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding WaitingText}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="changes are safe" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border><Border Grid.Column="2" Background="{StaticResource PanelBrush}" Padding="16" Margin="8,0,0,0"><StackPanel><TextBlock Text="ERRORS" Foreground="#FF8E8E" FontSize="10"/><TextBlock Text="{Binding ErrorsText}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="need attention" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border></Grid>
    <TextBlock Text="Last successful file sync" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding LastSyncText}" FontSize="16" Margin="0,4,0,20"/><TextBlock Text="Recently synced" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/><ListView ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" MaxHeight="180" VirtualizingPanel.IsVirtualizing="True"/>
    <DockPanel Margin="0,18,0,8"><TextBlock Text="Sync errors" FontSize="17" FontWeight="SemiBold"/><WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><Button Content="Retry all" Click="RetryAll_Click" Margin="4,0,0,0"/><Button Content="Show files" Click="ToggleErrors_Click" Margin="4,0,0,0"/></WrapPanel></DockPanel><TextBlock Text="{Binding ErrorSummary}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/><TextBlock Text="{Binding HistoricalErrorsText}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/><ListView x:Name="ErrorList" ItemsSource="{Binding ErrorItems}" Background="Transparent" BorderThickness="0" MaxHeight="360" VirtualizingPanel.IsVirtualizing="True" Visibility="Collapsed"><ListView.ItemTemplate><DataTemplate><Border Background="{StaticResource PanelBrush}" Padding="12" Margin="0,0,0,6"><StackPanel><TextBlock Text="{Binding RelativePath}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding StateText}" Foreground="#FFD9A0" Margin="0,4,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding UserMessage}" Foreground="#FFB0B0" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding AttemptsText}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/><Button Content="Retry this file" Click="RetryOperation_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView>
  </StackPanel></ScrollViewer>
</UserControl>
