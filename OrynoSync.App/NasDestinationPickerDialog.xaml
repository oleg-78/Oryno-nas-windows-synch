<Window x:Class="OrynoSync.App.NasDestinationPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oryno NAS - Choose destination" Width="460" Height="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="BreadcrumbText" Text="Oryno NAS" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <ListBox x:Name="ItemsList" Grid.Row="1" Margin="0,8,0,0"
                 SelectionMode="Single" MouseDoubleClick="ItemsList_MouseDoubleClick"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Up" x:Name="UpButton" Click="Up_Click" Margin="0,0,6,0"/>
            <Button Content="Refresh" Click="Refresh_Click" Margin="0,0,6,0"/>
            <Button Content="Create folder here" Click="CreateFolder_Click"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,8,0,0" Foreground="#C42B1C"
                   TextWrapping="Wrap" FontSize="11"/>
        <UniformGrid Grid.Row="4" Rows="1" Margin="0,12,0,0">
            <Button Content="Select destination" x:Name="SelectButton" IsDefault="True" Click="Button_Click_Select" Margin="0,0,6,0"/>
            <Button Content="Cancel" IsCancel="True"/>
        </UniformGrid>
    </Grid>
</Window>