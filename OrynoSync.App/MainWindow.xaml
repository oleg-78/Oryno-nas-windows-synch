<Window x:Class="OrynoSync.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Oryno Sync" Width="960" Height="680" MinWidth="390" MinHeight="520" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" Closing="Window_Closing" SizeChanged="Window_SizeChanged">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,9"/><Setter Property="MinHeight" Value="38"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
    <Style TargetType="TextBox"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
    <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="Sidebar" Grid.Column="0" Background="#15191D" BorderBrush="#2B3238" BorderThickness="0,0,1,0" Padding="24,28">
      <DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="ORYNO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Sync" FontSize="28" FontWeight="SemiBold" Margin="0,1,0,30"/><Button Content="Activity" Style="{StaticResource NavButton}" Click="Activity_Click"/><Button Content="Folders" Style="{StaticResource NavButton}" Click="Folders_Click"/><Button Content="Settings" Style="{StaticResource NavButton}" Click="Settings_Click"/></StackPanel><StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><TextBlock Text="DEVICE" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DeviceText" Text="Not authorized" TextWrapping="Wrap" Margin="0,4,0,16"/><TextBlock Text="STATUS" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SidebarStatus" Text="Disconnected" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel><Button x:Name="CompactMenu" Content="☰" Width="42" Margin="0,0,12,0" Visibility="Collapsed" Click="CompactMenu_Click"/><StackPanel><TextBlock x:Name="PageTitle" Text="Activity" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Text="Starting…" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></DockPanel>
      <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="#303940" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,22,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="LOCAL MIRROR" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="FolderText" Text="Not configured" FontSize="15" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="QueueText" Text="0 local changes waiting" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="Choose folder" Click="ChooseFolder_Click" Margin="14,0,0,0"/></Grid></Border>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <Border x:Name="ConnectionPanel" Background="{StaticResource PanelBrush}" BorderBrush="#303940" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16"><StackPanel><TextBlock Text="Server connection" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Server" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0"/><TextBox x:Name="ServerUrlBox" Text="https://oryno-nas.remo78.ru"/><TextBlock Text="Device authorization token" Foreground="{StaticResource MutedBrush}"/><PasswordBox x:Name="TokenBox"/><WrapPanel><Button Content="Connect" Click="Connect_Click"/><Button Content="Test connection" Click="TestConnection_Click"/></WrapPanel></StackPanel></Border>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="#303940" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16"><StackPanel><TextBlock Text="Oryno NAS metadata" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Sync root" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0"/><ComboBox x:Name="RootSelector" DisplayMemberPath="Name" SelectionChanged="RootSelector_SelectionChanged"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Last server revision" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="RevisionText" Text="—" FontSize="18" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Remote metadata" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="RemoteCountText" Text="—" FontSize="18" Margin="0,4,0,0"/></StackPanel></Grid><TextBlock x:Name="TransferNotice" Text="Content transfer is waiting for server S.2 support." Foreground="#E5B96B" Margin="0,16,0,0" TextWrapping="Wrap"/></StackPanel></Border>
        <TextBlock Text="Recent activity" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,10"/><ListView x:Name="ActivityList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" MinHeight="100"/>
      </StackPanel></ScrollViewer>
      <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,16,0,0"><Button x:Name="PauseButton" Content="Pause syncing" Click="Pause_Click"/><Button Content="Open folder" Click="OpenFolder_Click" Margin="0"/></WrapPanel>
    </Grid>
  </Grid>
</Window>
