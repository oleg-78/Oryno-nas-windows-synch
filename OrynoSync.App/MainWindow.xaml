<Window x:Class="OrynoSync.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Oryno Sync" Width="960" Height="680" MinWidth="390" MinHeight="520" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" Closing="Window_Closing" SizeChanged="Window_SizeChanged">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,9"/><Setter Property="MinHeight" Value="38"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
    <Style TargetType="TextBox"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="Sidebar" Grid.Column="0" Background="#15191D" BorderBrush="#2B3238" BorderThickness="0,0,1,0" Padding="24,28"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="ORYNO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Sync" FontSize="28" FontWeight="SemiBold" Margin="0,1,0,30"/><Button x:Name="ActivityNav" Content="Activity" Style="{StaticResource NavButton}" Click="Activity_Click"/><Button x:Name="FoldersNav" Content="Folders" Style="{StaticResource NavButton}" Click="Folders_Click"/><Button x:Name="SettingsNav" Content="Settings" Style="{StaticResource NavButton}" Click="Settings_Click"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><TextBlock Text="DEVICE" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DeviceText" Text="Not authorized" TextWrapping="Wrap" Margin="0,4,0,16"/><TextBlock Text="STATUS" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SidebarStatus" Text="Disconnected" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
    <Grid Grid.Column="1" Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button x:Name="CompactMenu" Content="☰" Width="42" Margin="0,0,12,0" Visibility="Collapsed" Click="CompactMenu_Click"/><StackPanel><TextBlock x:Name="PageTitle" Text="Activity" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Text="Starting…" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></DockPanel><ContentControl x:Name="CurrentView" Grid.Row="1" Margin="0,22,0,0"/></Grid>
  </Grid>
</Window>
