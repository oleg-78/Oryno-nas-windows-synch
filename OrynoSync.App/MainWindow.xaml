<Window x:Class="OrynoSync.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Oryno Sync" Width="920" Height="620" MinWidth="380" MinHeight="460" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" Closing="Window_Closing">
  <Grid Margin="28"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Margin="0,0,24,0"><TextBlock Text="ORYNO" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,2"/><TextBlock Text="Sync" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,34"/><Button Content="Activity" Click="Activity_Click" Style="{StaticResource NavButton}"/><Button Content="Folders" Click="Folders_Click" Style="{StaticResource NavButton}"/><Button Content="Settings" Click="Settings_Click" Style="{StaticResource NavButton}"/><Border Margin="0,35,0,0" Padding="12" Background="{StaticResource PanelBrush}" CornerRadius="8"><StackPanel><TextBlock Text="STATUS" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SidebarStatus" Text="Offline" FontSize="15" Margin="0,5,0,0"/><TextBlock x:Name="QueueText" Text="0 pending" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></Border></StackPanel>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="PageTitle" Text="Activity" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Grid.Row="1" Text="○ Offline  ·  Changes will sync when Oryno NAS is available" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,24"/><Border Grid.Row="2" Background="{StaticResource PanelBrush}" Padding="20" CornerRadius="8"><StackPanel><TextBlock Text="Sync folder" Foreground="{StaticResource MutedBrush}"/><DockPanel Margin="0,4,0,20"><TextBlock x:Name="FolderText" Text="Not configured" FontSize="16"/><Button DockPanel.Dock="Right" Content="Choose folder" Click="ChooseFolder_Click" Padding="14,7"/></DockPanel><TextBlock Text="Recent activity" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><ListView x:Name="ActivityList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"/></StackPanel></Border><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button x:Name="PauseButton" Content="Pause syncing" Click="Pause_Click" Padding="14,8" Margin="0,0,8,0"/><Button Content="Open folder" Click="OpenFolder_Click" Padding="14,8"/></StackPanel></Grid>
  </Grid>
</Window>
